NEXT_PUBLIC_SITE_URL=https://hourbridge.vercel.app
# Search Console token only (the content="…" value). Not the full meta tag and not google-site-verification=.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional override. Production already defaults to ca-pub-5437937713747043.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5437937713747043
# Numeric AdSense slot ids only. Leave blank until units exist; placeholders stay reserved.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=
